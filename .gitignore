# Reference papers — copyright; cite in README instead
Paper/

# External repos — cloned locally, not submodules; see README for clone instructions
fm4ar/
sbi-ear/

# Data — never commit, download via scripts/download_mast.py and scripts/download_abc.py
# (includes real JWST data e.g. data/jwst_wasp39b_oot/ — >100MB files, D11 → Zenodo)
# EXCEPTION: the three reduced spectra are 356 KB in total and both tracks need them
# (Track 2's V7 and V3 are blocked without them), so they are tracked by rule rather
# than by `git add -f`. This needs `data/*`, not `data/`: git does not descend into an
# excluded DIRECTORY, so a negation under a plain `data/` line silently does nothing.
data/*
!data/jwst_*_spectrum.csv

# Model checkpoints and training outputs
checkpoints/
outputs/
runs/

# Weights & Biases
wandb/

# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/
dist/
build/
*.so

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Environment
.env
*.env

# macOS
.DS_Store

# Large file formats (FITS, HDF5) — should live in data/ anyway
*.fits
*.fit
*.h5
*.hdf5

# Raw data drops (OOT frames, transmission spectra, opacities) shared as zips —
# large, not source; extracted into gitignored data/ subfolders
*.zip

# Model checkpoints + training snapshots — large + regenerable; release via Zenodo
configs/**/model__*.pt
configs/**/snapshots/
# every cyclegan run dir, not just configs/cyclegan/ — these are 107 MB each,
# over GitHub's 100 MB per-file limit. cyclegan_best.pt (30 MB) is kept.
configs/**/cyclegan_epoch_*.pt

# Figures generated by scripts — regenerable, not source
figures/*.png
figures/*.pdf
# ...except the figures embedded in the README (must be tracked to render on GitHub).
# If you embed a new figure, add it here or it renders as a broken image for everyone
# who clones. fig6_multitarget_v2.png was embedded and NOT listed, so it was broken.
!figures/fig6_multitarget.png
!figures/fig3_spectrum_fit.png
!figures/fig6_multitarget_v2.png
!figures/fig1_radius_is_the_fix.png
!figures/fig_a2_injection.png
!figures/fig_a4_floor.png
!figures/fig_h11_transfer.png
!figures/fig_g13_depth_noise.png
!figures/fig_a3_noise_proxy.png

# WASP-96b reduction artifacts (P5-D3): large FITS + raw data + local configs
pipeline_outputs_directory_*/
configs_reduce/
wasp96b_dms.yaml
wasp96b_stage3.yaml
scratchpad_*.log

# per-run training logs. Kept out of history because the metrics that matter are
# already in each run dir, and a killed run's log is a diagnostic not a result.
logs/

# Zenodo data bundle (staging + archive; .zenodo.json IS tracked)
zenodo_deposit/
mirage_zenodo_data_v1.tar.gz

# data archives built to move training sets between machines. Rebuildable from
# data/ with tar, so they are transfer artifacts and do not belong in history.
mirage_*.tgz
mirage_*.tar.gz

Making MIRAGE Publishable_ A Real-Noise Audit of Amortized Exoplanet Retrieval.pdf
